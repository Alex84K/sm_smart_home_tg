# ── общее ─────────────────────────────────
LOG_LEVEL=info

# ── tg-gateway ────────────────────────────
TELEGRAM_BOT_TOKEN=token
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_ALLOWED_IDS=123456789,987654321
# Чат для получения системных алертов (ID пользователя или группы)
TELEGRAM_ALERT_CHAT_ID=123456789
CORE_PORT=8080
CORE_API_URL=http://core:8080
CORE_API_TOKEN=token

# ── MQTT брокер ───────────────────────────
# Адрес брокера (внутри compose сети backend: tcp://mosquitto:1883; локально: tcp://127.0.0.1:1883)
MQTT_URL=tcp://mosquitto:1883
MQTT_GATEWAY_USER=tg-gateway
MQTT_GATEWAY_PASSWORD=gateway_password

# ── сборка docker (опционально, по умолчанию ~/.netrc хоста) ──
# Путь к .netrc с fine-grained токеном GitHub (Contents: Read-only для sm_smart_home_core_go)
# NETRC_FILE=/path/to/.netrc
