# ── общее ─────────────────────────────────
LOG_LEVEL=info

# ── tg-gateway ────────────────────────────
TELEGRAM_BOT_TOKEN=token
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_ALLOWED_IDS=123456789,987654321
CORE_PORT=8080
CORE_API_URL=http://core:8080
CORE_API_TOKEN=token

# ── сборка docker (опционально, по умолчанию ~/.netrc хоста) ──
# Путь к .netrc с fine-grained токеном GitHub (Contents: Read-only для sm_smart_home_core_go)
# NETRC_FILE=/path/to/.netrc
